#!/bin/sh
# Refuse a commit that carries a name from the forbidden list.
#
# `src/sanitized.test.ts` is the same rule at build time; this is the same rule at the
# only moment it is still cheap to fix. Enable it -- git does not clone hooks:
#
#     git config core.hooksPath .githooks
#
# THE TERMS ARE NOT IN THIS REPOSITORY. A guard that spells what it forbids publishes it,
# and splitting the word into adjacent fragments defeats a grep, not a reader -- which is
# the mistake the first version of this hook made, in the commit that added it. The list
# lives at $CODEMAP_FORBIDDEN_NAMES or ~/.config/codemap/forbidden-names: one term per
# line, '#' for comments, matched case-insensitively.
#
# With no list this passes quietly. A stranger who clones this repository has nothing to
# check against and should not be blocked; the maintainer has the file.
#
# It checks the STAGED CONTENT of each touched file rather than the diff's added lines.
# Deliberate twice: no file should contain a forbidden name at all, so "you touched a file
# that has one" is the right failure -- and matching added lines needs a '^+++' pattern,
# which the ugrep on this machine rejects as invalid syntax where GNU grep accepts it. An
# earlier version did exactly that and passed a probe commit it should have refused: the
# pipeline was erroring, not matching. Do not "fix" this back into a diff scan.

list="${CODEMAP_FORBIDDEN_NAMES:-$HOME/.config/codemap/forbidden-names}"
[ -r "$list" ] || exit 0

# One alternation, built at run time from the file. Blank and '#' lines dropped.
needle=$(grep -v '^[[:space:]]*#' "$list" | grep -v '^[[:space:]]*$' | paste -sd '|' -)
[ -n "$needle" ] || exit 0

status=0
for f in $(git diff --cached --name-only --diff-filter=ACM); do
  # -I skips binaries (the vendored .wasm grammars); ":$f" is the staged blob, not the
  # working tree, so a fix you forgot to `git add` does not let the commit through.
  # -l, not -n: printing the matching line would put the term in the terminal and the
  # reflog. The path is enough for whoever holds the list.
  if git show ":$f" 2>/dev/null | grep -I -q -i -E "$needle"; then
    [ "$status" -eq 0 ] && echo "pre-commit: a forbidden name is in this commit:" >&2
    echo "  $f" >&2
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo >&2
  echo "Use the placeholder from your mapping. It lives with the list, outside this" >&2
  echo "repository, and it must stay there. To override once: git commit --no-verify" >&2
fi
exit "$status"
