#!/bin/sh
# Refuse a commit that carries the client's name.
#
# `src/sanitized.test.ts` is the same rule at build time; this is the same rule at the
# only moment it is still cheap to fix. Both exist because the one-time sweep of
# 2026-07-31 drifted back twice -- `0f813ba` re-sanitized once, and four more sites had
# returned by `b12f42e` -- and a rule with no exit predicate is a rule enforced by
# whoever happens to notice.
#
# Enable it -- git does not clone hooks:  git config core.hooksPath .githooks
#
# The needle is assembled at runtime on purpose: a hook spelling the name would be the
# leak it exists to prevent, and this file is published like everything else here.
#
# It checks the STAGED CONTENT of each touched file rather than the diff's added lines.
# That is deliberate twice over: after the history rewrite no file contains the name at
# all, so "you touched a file that has it" is the right failure; and matching added
# lines needs a `^+++` pattern, which the ugrep on this machine rejects as invalid
# syntax where GNU grep accepts it. Do not "fix" this back into a diff scan.
needle="$(REDACTED)|$(REDACTED)"

status=0
for f in $(git diff --cached --name-only --diff-filter=ACM); do
  # -I skips binaries (the vendored .wasm grammars); ":$f" is the staged blob, not the
  # working tree, so a fix you forgot to `git add` does not let the commit through.
  hits=$(git show ":$f" 2>/dev/null | grep -I -n -i -E "$needle")
  if [ -n "$hits" ]; then
    [ "$status" -eq 0 ] && echo "pre-commit: the client name is in this commit." >&2
    echo "$hits" | head -5 | sed "s|^|  $f:|" >&2
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo >&2
  echo "Use the 'Acme' placeholder. The mapping lives in memory, not in this repo," >&2
  echo "and it must stay that way. To override once: git commit --no-verify" >&2
fi
exit "$status"
