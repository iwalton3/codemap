{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codemap:decision-measurement:1",
  "title": "Decision measurement input, design only",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "cohort": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "followUpEnd": {
          "type": "string",
          "format": "date-time"
        },
        "followUpCoverage": {
          "type": "string",
          "enum": [
            "complete",
            "sampled",
            "none"
          ]
        }
      },
      "required": [
        "id",
        "repositories",
        "start",
        "end",
        "followUpEnd",
        "followUpCoverage"
      ],
      "additionalProperties": false
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "findingId": {
            "type": "string",
            "minLength": 1
          },
          "claimId": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "act": {
            "type": "string",
            "enum": [
              "fix",
              "close"
            ]
          },
          "requirementAuthority": {
            "type": "string",
            "enum": [
              "required",
              "not-required",
              "unknown"
            ]
          },
          "authorityBeforeAct": {
            "type": "string",
            "enum": [
              "valid",
              "absent",
              "invalid",
              "unknown"
            ]
          },
          "classificationSource": {
            "type": "string",
            "minLength": 1
          },
          "eligible": {
            "type": "boolean"
          },
          "evidenceGrade": {
            "type": "string",
            "enum": [
              "executable",
              "inspection",
              "none"
            ]
          },
          "reproducerSupplied": {
            "type": "boolean"
          },
          "rerun": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "unknown",
              "not-run"
            ]
          },
          "commandIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "outcome": {
            "type": "string",
            "enum": [
              "fixed",
              "factually-refuted",
              "decision-needed",
              "unknown"
            ]
          },
          "errorsDiscovered": {
            "type": "integer",
            "minimum": 0
          },
          "independence": {
            "type": "string",
            "enum": [
              "verified",
              "unverified",
              "unknown"
            ]
          },
          "modelIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "runIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "secondPass": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "result": {
                "type": "string",
                "enum": [
                  "sound",
                  "false-close",
                  "unknown"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "at",
              "result",
              "source"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "repository",
          "findingId",
          "claimId",
          "at",
          "act",
          "requirementAuthority",
          "authorityBeforeAct",
          "classificationSource",
          "eligible",
          "evidenceGrade",
          "reproducerSupplied",
          "rerun",
          "commandIds",
          "outcome",
          "errorsDiscovered",
          "independence",
          "modelIds",
          "runIds"
        ],
        "additionalProperties": false
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "batchId": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "postedAt": {
            "type": "string",
            "format": "date-time"
          },
          "exit": {
            "type": "string",
            "enum": [
              "answered",
              "partial",
              "unanswered",
              "interpretation",
              "parked",
              "conflict",
              "ruled-unexecuted"
            ]
          },
          "followUp": {
            "type": "string",
            "enum": [
              "answered",
              "partial",
              "unanswered",
              "interpretation",
              "parked",
              "conflict",
              "ruled-unexecuted",
              "unobserved"
            ]
          },
          "deadline": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "batchId",
          "repository",
          "postedAt",
          "exit",
          "followUp"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "cohort",
    "attempts",
    "questions"
  ],
  "additionalProperties": false
}
