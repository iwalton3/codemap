{
  "name": "codemap",
  "version": "0.2.0",
  "private": true,
  "description": "Codebase-agnostic semantic map: anchors documented claims to hashed code so staleness becomes visible.",
  "type": "module",
  "engines": {
    "node": ">=23.4"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test \"dist/**/*.test.js\"",
    "serve": "node dist/serve.js",
    "test:e2e": "tsc && node --test \"dist/e2e/**/*.e2e.js\""
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "web-tree-sitter": "^0.26.10"
  }
}
