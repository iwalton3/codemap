{
  "name": "codemap",
  "version": "0.2.0",
  "private": true,
  "description": "Codebase-agnostic semantic map: anchors documented claims to hashed code so staleness becomes visible.",
  "type": "module",
  "engines": {
    "node": ">=23.4"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc && tsc -p web",
    "test": "npm run unit && npm run e2e",
    "serve": "node dist/serve.js",
    "unit": "tsc && tsc -p web && node --no-warnings --test --test-isolation=none --test-concurrency=1 \"dist/**/*.test.js\"",
    "e2e": "tsc && tsc -p web && node --no-warnings --test --test-concurrency=1 \"dist/e2e/**/*.e2e.js\""
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "web-tree-sitter": "^0.26.10"
  }
}
